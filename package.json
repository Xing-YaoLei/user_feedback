{
  "name": "protobuf-field-rewriter",
  "version": "1.0.0",
  "private": true,
  "description": "Byte-preserving Protobuf message field rewriter for Node.js",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "start": "node examples/demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
